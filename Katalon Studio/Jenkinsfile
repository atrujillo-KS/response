// Jenkinsfile v1.13.1 — Orchestrator

pipeline {
    agent { label 'built-in' }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        cron('0 1 * * *')
    }

    stages {
        stage('RESPONSE') {
            steps {
                script {
                    def result = build(job: 'RES_2.0', wait: true, propagate: false)
                    env.RES_BUILD = result.number
                    env.RES_RESULT = result.result
                }
            }
        }
        stage('GS2.0') {
            steps {
                script {
                    def result = build(job: 'GS_2.0', wait: true, propagate: false)
                    env.GS_BUILD = result.number
                    env.GS_RESULT = result.result
                }
            }
        }
    }

    post {
        always {
            script {
                def jenkins = env.JENKINS_URL ?: "${env.BUILD_URL}".replaceAll(/job\/.*/, '')
                def links = """
                    <h2>Child Job Reports</h2>
                    <ul>
                        <li><a href="${jenkins}job/RES_2.0/${env.RES_BUILD ?: 'lastBuild'}/Test_20Summary_20Report/">RES_2.0 — Test Summary</a></li>
                        <li><a href="${jenkins}job/RES_2.0/${env.RES_BUILD ?: 'lastBuild'}/Resource_20Usage/">RES_2.0 — Resource Usage</a></li>
                        <li><a href="${jenkins}job/GS_2.0/${env.GS_BUILD ?: 'lastBuild'}/Test_20Summary_20Report/">GS_2.0 — Test Summary</a></li>
                        <li><a href="${jenkins}job/GS_2.0/${env.GS_BUILD ?: 'lastBuild'}/Resource_20Usage/">GS_2.0 — Resource Usage</a></li>
                    </ul>
                """
                writeFile file: 'report-links.html', text: """<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Orchestrator Reports</title>
<style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;padding:2rem;color:#333034}
h2{margin-bottom:1rem}ul{list-style:none;padding:0}li{margin:0.5rem 0}
a{color:#4545BF;text-decoration:none;font-size:1.1rem}a:hover{text-decoration:underline}</style>
</head><body>${links}</body></html>"""
            }
            publishHTML(target: [
                reportName: 'Report Links',
                reportDir: '.',
                reportFiles: 'report-links.html',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])
            script {
                def failed = []
                if (env.RES_RESULT != 'SUCCESS') failed.add("RES_2.0 (${env.RES_RESULT})")
                if (env.GS_RESULT != 'SUCCESS') failed.add("GS_2.0 (${env.GS_RESULT})")
                if (failed) {
                    echo "Failed jobs: ${failed.join(', ')}"
                    currentBuild.result = 'FAILURE'
                } else {
                    echo 'All jobs passed.'
                }
            }
        }
    }
}
