{
  "config": {
    "baseUrl": "https://qa.awsc.leadfusion.com",
    "tokenUrl": "/oauth2/oauth2/token",
    "authHeader": "Basic YXBpY2xpZW50OmFwaWNsaWVudHNlY3JldA=="
  },
  "tests": [
    {
      "name": "PAM_Category_ALL_Endpoints",
      "steps": [
        {
          "name": "Add New Category",
          "method": "POST",
          "path": "/cc-api-v2/resource/pam/category?siteId=qatest&clientId=19500",
          "body": {
            "name": "Test Category",
            "clientId": 19500,
            "siteId": "qatest"
          },
          "expect": { "status": 200 },
          "extract": {
            "newCategoryId": "data.categories[?name=='Test Category'].categoryId"
          }
        },
        {
          "name": "Get All Categories",
          "method": "GET",
          "path": "/cc-api-v2/resource/pam/category?siteId=qatest&clientId=19500",
          "expect": {
            "status": 200,
            "body": {
              "data.categories[?categoryId==${newCategoryId}].name": "Test Category"
            }
          }
        },
        {
          "name": "Update Category Name",
          "method": "PATCH",
          "path": "/cc-api-v2/resource/pam/category?siteId=qatest&clientId=19500",
          "body": {
            "name": "Test Category new name",
            "categoryId": "${newCategoryId}",
            "clientId": 19500,
            "siteId": "qatest"
          },
          "expect": {
            "status": 200,
            "body": {
              "data.categories[?categoryId==${newCategoryId}].name": "Test Category new name"
            }
          }
        },
        {
          "name": "Copy Category",
          "method": "POST",
          "path": "/cc-api-v2/resource/pam/category?siteId=qatest&clientId=19500",
          "body": {
            "name": "Test Category copy",
            "clientId": 19500,
            "siteId": "qatest",
            "enabled": true
          },
          "expect": { "status": 200 },
          "extract": {
            "copiedCategoryId": "data.categories[?name=='Test Category copy'].categoryId"
          }
        },
        {
          "name": "Delete Original Category",
          "method": "DELETE",
          "path": "/cc-api-v2/resource/pam/category",
          "body": {
            "categoryId": "${newCategoryId}",
            "clientId": 19500,
            "siteId": "qatest"
          },
          "expect": { "status": 200 }
        },
        {
          "name": "Delete Copied Category",
          "method": "DELETE",
          "path": "/cc-api-v2/resource/pam/category",
          "body": {
            "categoryId": "${copiedCategoryId}",
            "clientId": 19500,
            "siteId": "qatest"
          },
          "expect": { "status": 200 }
        }
      ]
    },
    {
      "name": "PAM_Adjustments_ALL_Endpoints",
      "steps": [
        {
          "name": "Add New Adjustment",
          "method": "POST",
          "path": "/cc-api-v2/resource/pam/adjustments",
          "body": {
            "clientId": 827889422,
            "siteId": "fem",
            "categoryId": 361,
            "type": "Test type",
            "conditions": "Test conditions",
            "adjustment": "Test adjustment",
            "paymentMethod": 0
          },
          "expect": {
            "status": 201,
            "body": {
              "data.adjustments[0].type": "Test type",
              "data.adjustments[0].conditions": "Test conditions",
              "data.adjustments[0].adjustment": "Test adjustment"
            }
          },
          "extract": {
            "newAdjustmentId": "data.adjustments[0].id"
          }
        },
        {
          "name": "Get All Adjustments",
          "method": "GET",
          "path": "/cc-api-v2/resource/pam/adjustments?siteId=fem&clientId=827889422&categoryId=361",
          "expect": {
            "status": 200,
            "body": {
              "data.adjustments[?id==${newAdjustmentId}].type": "Test type"
            }
          }
        },
        {
          "name": "Update Adjustment",
          "method": "PATCH",
          "path": "/cc-api-v2/resource/pam/adjustments",
          "body": {
            "id": "${newAdjustmentId}",
            "clientId": 827889422,
            "siteId": "fem",
            "categoryId": 361,
            "type": "TestType",
            "conditions": "PropertyType=1",
            "adjustment": "0.100",
            "paymentMethod": 0
          },
          "expect": { "status": 200 }
        },
        {
          "name": "Verify Updated Adjustment",
          "method": "GET",
          "path": "/cc-api-v2/resource/pam/adjustments?siteId=fem&clientId=827889422&categoryId=361",
          "expect": {
            "status": 200,
            "body": {
              "data.adjustments[?id==${newAdjustmentId}].type": "TestType",
              "data.adjustments[?id==${newAdjustmentId}].conditions": "PropertyType=1",
              "data.adjustments[?id==${newAdjustmentId}].adjustment": "0.100"
            }
          }
        },
        {
          "name": "Delete Adjustment",
          "method": "DELETE",
          "path": "/cc-api-v2/resource/pam/adjustments",
          "body": {
            "categoryId": 361,
            "clientId": 827889422,
            "siteId": "fem",
            "adjustmentId": "${newAdjustmentId}"
          },
          "expect": {
            "status": 200,
            "body": {
              "data.status": "SUCCESS",
              "data.message": "Adjustment deleted successfully."
            }
          }
        },
        {
          "name": "Verify Adjustment Deleted",
          "method": "GET",
          "path": "/cc-api-v2/resource/pam/adjustments?siteId=fem&clientId=827889422&categoryId=361",
          "expect": { "status": 404 }
        }
      ]
    },
