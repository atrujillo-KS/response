    {
      "name": "ClientAPI_ALL_Endpoints",
      "steps": [
        {
          "name": "Add ClientAPI",
          "method": "POST",
          "path": "/cc-api-v2/resource/clientapi",
          "body": {
            "apiType": "basic",
            "clientId": 19500,
            "siteId": "qatest",
            "apiName": "TEST Test Client API",
            "apiDescription": "This is a test Client API for PostmanTest",
            "useFields": false,
            "attributes": {
              "CORS_DOMAIN": "https://qa.awsc.leadfusion.com",
              "USERNAME": "testUsername",
              "PASSWORD": "testPassword",
              "REQUEST_ENDPOINT": "https://qa.awsc.leadfusion.com/endpoint"
            }
          },
          "expect": {
            "status": 200,
            "body": {
              "data.status": "success"
            }
          },
          "extract": {
            "newClientAPIId": "data.apiId"
          }
        },
        {
          "name": "Get All ClientAPIs",
          "method": "GET",
          "path": "/cc-api-v2/resource/clientapi",
          "expect": {
            "status": 200
          }
        },
        {
          "name": "Update ClientAPI",
          "method": "PATCH",
          "path": "/cc-api-v2/resource/clientapi",
          "body": {
            "apiId": "${newClientAPIId}",
            "apiType": "basic",
            "clientId": 19500,
            "siteId": "qatest",
            "apiName": "EDIT Test Client API",
            "apiDescription": "EDIT This is a test Client API.",
            "useFields": false,
            "attributes": {
              "CORS_DOMAIN": "https://qa.awsc.leadfusion.com",
              "USERNAME": "EDITUsername",
              "PASSWORD": "EDITPassword",
              "REQUEST_ENDPOINT": "https://qa.awsc.leadfusion.com/endpoint"
            },
            "fields": [
              {"LABEL": "Edit New Name", "KEY": "first_name", "CUSTOMER_KEY_MAP": "salesforce_firstname", "TYPE": "String", "REQUIRED": true},
              {"LABEL": "Edit Last Name", "KEY": "last_name", "CUSTOMER_KEY_MAP": "salesforce_lastname", "TYPE": "String", "REQUIRED": true},
              {"LABEL": "Edit Customer ID", "KEY": "customer_id", "CUSTOMER_KEY_MAP": "salesforce_customer_id", "TYPE": "Numeric", "REQUIRED": false}
            ]
          },
          "expect": {
            "status": 200,
            "body": {
              "data.apiId": "${newClientAPIId}"
            }
          }
        },
        {
          "name": "Delete ClientAPI",
          "method": "DELETE",
          "path": "/cc-api-v2/resource/clientapi",
          "body": {
            "apiId": "${newClientAPIId}"
          },
          "expect": {
            "status": 200,
            "body": {
              "data.status": "success"
            }
          }
        }
      ]
