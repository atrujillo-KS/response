// Jenkinsfile v1.14.0 — API_Services
node('ec2-agent-01') {
    properties([
        parameters([
            choice(name: 'ENVIRONMENT', choices: ['PROD', 'QA', 'STG', 'AWS'], description: 'Target environment (branch + profile)')
        ])
    ])

    def envBranch = params.ENVIRONMENT ?: 'PROD'

    deleteDir()
    checkout([$class: 'GitSCM',
        branches: [[name: "*/${envBranch}"]],
        userRemoteConfigs: scm.userRemoteConfigs
    ])

    def runner = load 'Katalon Studio/Jenkinsfile-runner.groovy'
    runner.run(
        katalon_dir:     'Katalon Studio/API_Services',
        katalon_project: 'Response_Services.prj',
        katalon_suite:   'Test Suites/Headless-PROD',
        environment:     envBranch
    )
}
