  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/p",
      "value": "Though it happens in merely a few seconds, payment processing involves multiple stages and several actors working behind the scenes."
    }
  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/ol/li",
      "value": "A cardholder places an order by swiping a card's magnetic stripe, inserting its chip into a terminal, or using its chip to exchange data with a card reader."
    }
  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/ol/li[2]",
      "value": "The merchant submits the transaction to a payment processor."
    }
  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/ol/li[3]",
      "value": "The payment processor sends the information to a card network (Visa, MasterCard, American Express, Discover)."
    }
  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/ol/li[4]",
      "value": "The card network passes the payment information to the cardholder's bank."
    }
  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/ol/li[5]",
      "value": "The cardholder's bank verifies whether the cardholder has the appropriate funds or credit to complete the purchase. The bank may also run through additional security measures to verify whether they purchase is legitimate, and not fraudulent. The message that the payment has been approved or denied flows back through the same channels it did to get to the cardholder's bank."
    }
  },
  {
    "verifyText": {
      "id": "//div[@id='lf_inline_modal_body']/div/ol/li[6]",
      "value": "If the payment has been approved, the merchant batches and submits the transactions to the payment processor for settlement. The issuing bank bills the cardholder and pays the payment processor, and the payment processor pays the merchant."
    }
  },
